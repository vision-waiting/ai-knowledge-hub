SPRING_PROFILES_ACTIVE=dev
# Development defaults only. For deployment, follow docs/deployment.md and use prod.
SERVER_PORT=8080
JWT_SECRET=change-this-development-secret-to-at-least-32-chars
UPLOAD_DIR=./uploads
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DOCKER_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ai_knowledge_hub
MYSQL_USERNAME=knowledge
MYSQL_PASSWORD=knowledge
REDIS_HOST=localhost
REDIS_ENABLED=false
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_ENABLED=false
QDRANT_COLLECTION=knowledge_chunks
QDRANT_PORT=6333
LLM_ENABLED=false
AI_MODE=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional provider-specific reasoning control; blank keeps provider default.
LLM_REASONING_EFFORT=
# 0 keeps provider default; local deployment uses a bounded output budget.
LLM_MAX_TOKENS=0
# Set true only when LLM_* points to the local model; chat then defaults to local.
LOCAL_LLM_ENABLED=false
# Optional second provider for explicit per-question cloud selection. Never sent to frontend.
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
CLOUD_LLM_REASONING_EFFORT=
CLOUD_LLM_MAX_TOKENS=2048
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
VITE_API_BASE_URL=http://localhost:8080/api
VITE_BACKEND_URL=http://127.0.0.1:8080
WEB_PORT=8088
BACKEND_DOCKER_PORT=8080
AI_REQUESTS_PER_MINUTE=30
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_THRESHOLD=0.2
CONTEXT_MAX_CHARS=12000

# Optional Windows Ollama executable/model directory. Blank uses PATH/default storage.
OLLAMA_EXECUTABLE=
OLLAMA_MODELS=
# Required only when enabling the optional-storage Compose profile.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

