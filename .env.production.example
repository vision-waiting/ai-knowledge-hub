# Copy to .env only for a NEW deployment. Never overwrite an existing .env.
# Generate independent random secrets before starting. Empty values cannot start prod.
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DOCKER_PORT=3307
MYSQL_DATABASE=ai_knowledge_hub
MYSQL_USERNAME=knowledge
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Same-host Compose bridge only. For a remote database use VERIFY_IDENTITY and false.
MYSQL_SSL_MODE=DISABLED
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
SERVER_PORT=8080
UPLOAD_DIR=./uploads
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_ENABLED=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_chunks
LLM_ENABLED=false
LOCAL_LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
WEB_PORT=8088
BACKEND_DOCKER_PORT=8080
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
